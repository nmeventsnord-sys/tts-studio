# ── Time To Smile Studio — variables d'environnement ──
# Copier en .env.local pour le développement (pnpm dev). Ne jamais commiter de vraies valeurs.
# En production : Vercel → projet tts-studio → Settings → Environment Variables.

# Supabase — côté navigateur (clés publiques, préfixe VITE_)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Supabase — côté serveur uniquement (fonctions api/ et script d'ingestion)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API → clé « service_role » / secret
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (emails : mot de passe oublié, « Besoin d'aide ? ») → brevo.com → SMTP & API
BREVO_API_KEY=
# Expéditeur validé dans Brevo, et destinataire des messages d'aide (défaut : contact@timetosmile.fr)
BREVO_SENDER_EMAIL=contact@timetosmile.fr
BREVO_SENDER_NAME=Time To Smile Studio
HELP_NOTIFY_EMAIL=contact@timetosmile.fr

# Zing (réception des templates dans les fiches) : POST {ZING_API_URL}/api/send-template
ZING_API_URL=https://zing-crm--nmeventsnord.replit.app

# URL publique du Studio (liens des emails « mot de passe oublié »)
PUBLIC_URL=https://perso.timetosmile.fr

# Facultatif : secret des jetons du fil d'aide des invités (défaut : dérivé de la clé service_role)
STUDIO_SECRET=

# ── Script d'ingestion uniquement (pnpm ingest:themes, sur ton PC — inutile sur Vercel) ──
# Dossier LOCAL des templates (Google Drive pour ordinateur), ex. G:/.shortcut-targets-by-id/<id>/Template
TEMPLATES_PATH=
# Analyse IA des textes par défaut → console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Si la clé n'est rattachée à aucun workspace → console.anthropic.com/settings/workspaces (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
